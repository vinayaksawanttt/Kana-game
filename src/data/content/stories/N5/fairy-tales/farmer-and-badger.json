  "quiz": [
    {
      "question": "タヌキはどうしておばあさんに「ひもを解いてください」と言いましたか？",
      "options": [
        "仕事を手伝いたいから",
        "ご飯を食べたいから",
        "おじいさんが呼んだから",
        "海に行きたいから"
      ],
      "answerIndex": 0,
      "explanation": "「仕事を手伝いたいから」 is correct: 「タヌキは毎日、おじいさんの作った野菜を全部食べました。」 (Every day, the raccoon dog ate all the vegetables the old man had grown.)"
    },
    {
      "question": "ウサギはタヌキの背中の草をどうしましたか？",
      "options": [
        "全部食べました",
        "火をつけました",
        "水に入れました",
        "土をかけました"
      ],
      "answerIndex": 1,
      "explanation": "「火をつけました」 is correct: 「ウサギは後ろから、タヌキの背中の草に火をつけました。」 (The rabbit set the grass on the raccoon’s back on fire from behind.)"
    },
    {
      "question": "タヌキが海で乗った船は何の船でしたか？",
      "options": [
        "木の船",
        "大きい船",
        "土の船",
        "赤い船"
      ],
      "answerIndex": 2,
      "explanation": "「土の船」 is correct: 「タヌキは土の船に乗りました。」 (The raccoon dog got into the boat made of clay.)"
    }
  ],
