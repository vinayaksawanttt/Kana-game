  "quiz": [
    {
      "question": "田中さんはどうして夜遅くまで勉強しましたか？",
      "options": [
        "明日テストがあるから",
        "本が好きだから",
        "眠くなかったから",
        "友だちと約束したから"
      ],
      "answerIndex": 0,
      "explanation": "「明日テストがあるから」 is correct: 「昨日の夜、田中さんは部屋で日本語を勉強しました。」 (Last night, Mr. Tanaka studied Japanese in his room.)"
    },
    {
      "question": "田中さんは疲れたとき何を飲みましたか？",
      "options": [
        "冷たい水",
        "コーヒー",
        "ジュース",
        "温かいお茶"
      ],
      "answerIndex": 3,
      "explanation": "「温かいお茶」 is correct: 「少し疲れましたから、温かいお茶を飲みました。」 (I was feeling a little tired, so I had some hot tea.)"
    },
    {
      "question": "田中さんは何時ごろに寝ましたか？",
      "options": [
        "十一時ごろ",
        "十二時ごろ",
        "一時ごろ",
        "二時ごろ"
      ],
      "answerIndex": 2,
      "explanation": "「一時ごろ」 is correct: 「一時ごろにベッドに入って、静かに寝ました。」 (I went to bed around 1:00 a.m. and slept peacefully.)"
