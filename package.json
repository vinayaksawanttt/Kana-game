{
    "name": "kana-game",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": "22.x"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "build:grammar": "tsx scripts/build-grammar.ts",
        "build:kanji-data": "tsx scripts/build-kanji-data.ts",
        "build:radicals": "tsx scripts/build-radicals.ts",
        "build:vocabulary-data": "tsx scripts/build-vocabulary-data.ts",
        "build:grammar-data": "tsx scripts/build-grammar.ts",
        "build:story-placeholders": "tsx scripts/build-story-placeholders.ts",
        "build:learn-placeholders": "tsx scripts/build-learn-placeholders.ts",
        "build:dictionary": "tsx scripts/build-dictionary.ts",
        "build:strokes": "tsx scripts/build-strokes.ts",
        "build:kanji-vocab": "tsx scripts/build-kanji-vocab.ts",
        "build:shiritori-data": "tsx scripts/build-shiritori-data.ts",
        "build:homophones": "tsx scripts/build-homophones.ts",
        "build:audio:kana": "tsx scripts/build-kana-audio.ts",
        "build:audio:kanji": "tsx scripts/build-kanji-audio.ts",
        "build:audio:stories": "tsx scripts/build-story-audio.ts",
        "build:reverse-prompts": "tsx scripts/build-reverse-srs-prompts.ts",
        "build:manifest": "tsx scripts/build-data-manifest.ts",
        "build:sw": "tsx scripts/build-sw.ts",
        "verify:offline": "tsx scripts/verify-offline.ts",
        "enrich:dry-run": "tsx scripts/enrich-with-deepl.ts --dry-run && tsx scripts/enrich-stories-deepl.ts --dry-run && tsx scripts/enrich-vocab-deepl.ts --dry-run && tsx scripts/enrich-grammar-deepl.ts --dry-run && tsx scripts/build-reverse-srs-prompts.ts --dry-run && tsx scripts/build-homophones.ts --dry-run && tsx scripts/enrich-grammar-drills.ts --dry-run && tsx scripts/enrich-kanji-examples.ts --dry-run && tsx scripts/enrich-stories-quiz.ts --dry-run",
        "enrich:shiritori": "tsx scripts/enrich-with-deepl.ts --target=shiritori",
        "enrich:stories": "tsx scripts/enrich-stories-deepl.ts",
        "enrich:vocab": "tsx scripts/enrich-vocab-deepl.ts",
        "enrich:grammar": "tsx scripts/enrich-grammar-deepl.ts",
        "enrich:grammar-drills": "tsx scripts/enrich-grammar-drills.ts --levels=N5,N4,N3,N2",
        "enrich:kanji-examples": "tsx scripts/enrich-kanji-examples.ts",
        "enrich:story-quiz": "tsx scripts/enrich-stories-quiz.ts",
        "enrich:all": "npm run enrich:shiritori && npm run enrich:stories && npm run enrich:vocab && npm run enrich:grammar && npm run enrich:grammar-drills && npm run enrich:kanji-examples && npm run enrich:story-quiz && npm run build:reverse-prompts && npm run build:homophones",
        "build:data": "npm run build:kanji-data && npm run build:radicals && npm run build:vocabulary-data && npm run build:grammar-data && npm run build:story-placeholders && npm run build:dictionary && npm run build:strokes && npm run build:kanji-vocab && npm run build:shiritori-data",
        "prebuild": "npm run build:radicals && npm run build:learn-placeholders && npm run build:manifest && npm run build:sw",
        "test": "vitest run"
    },
    "dependencies": {
        "dexie": "^4.4.7",
        "gray-matter": "^4.0.3",
        "kuromoji": "^0.1.2",
        "lucide-react": "^1.61.0",
        "next": "16.4.3",
        "next-mdx-remote": "^6.0.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "remark-gfm": "^4.0.1",
        "ts-fsrs": "^5.4.2"
    },
    "devDependencies": {
        "@tailwindcss/turbopack": "^4",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/kuromoji": "^0.1.3",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.4.3",
        "fake-indexeddb": "^6.2.7",
        "jsdom": "^30.1.3",
        "msedge-tts": "^2.1.1",
        "tailwindcss": "^4",
        "tsx": "^4.23.15",
        "typescript": "^5",
        "vitest": "^3.2.7"
    }
}
