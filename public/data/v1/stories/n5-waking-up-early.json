  "quiz": [
    {
      "question": "田中さんは何時に起きますか？",
      "options": [
        "五時",
        "六時",
        "七時",
        "八時"
      ],
      "answerIndex": 1,
      "explanation": "「六時」 is correct: 「毎朝、田中さんは六時に起きます。」 (Every morning, Mr. Tanaka wakes up at 6:00.)"
    },
    {
      "question": "田中さんは朝ごはんに何を食べましたか？",
      "options": [
        "ごはん",
        "魚",
        "パン",
