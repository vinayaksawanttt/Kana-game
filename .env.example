# Environment configuration template
# Copy this file to .env.local or .env to configure your local environment.
# Never commit real API keys or secrets to version control.

# Optional: used if you prefer OpenAI TTS over the default offline Edge TTS
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: used for Google Gemini high-definition Japanese TTS voices (Aoede, Kore, Charon)
# Supports single key, comma-separated keys, or numbered keys (GEMINI_API_KEY1, GEMINI_API_KEY2, etc.)
# GEMINI_API_KEY=your_gemini_api_key_here
